%% cowlib 2.20.0 and later use maybe_expr, which is only enabled by default in
%% OTP 27 and later. Constrain gun's cowlib dependency on older releases.
case list_to_integer(erlang:system_info(otp_release)) < 27 of
    true ->
        Overrides = proplists:get_value(overrides, CONFIG, []),
        lists:keystore(overrides, 1, CONFIG,
            {overrides, [{override, gun, [{deps, [{cowlib, "~> 2.19.0"}]}]} | Overrides]});
    false ->
        CONFIG
end.
